; Reference schema: groups inlined where they are used (RFC 8610 §2.1.2,
; §3.7, §3.9): group references, a group made optional with ?, an unwrapped
; map (~), a group socket ($$), and a group in a record array.

message = {
    header,
    ? annotation,
    ~stamp,
    $$message-ext,
    body: tstr,
}

header = ( id: uint, kind: tstr )

annotation = ( note: tstr, ? author: tstr )

stamp = { created: uint }

$$message-ext //= ( version: uint )

; A record whose first members come from a group
point = [coords, label: tstr]

coords = ( x: int, y: int )

; Choices between groups (RFC 8610 §2.2.2): one alternative's members or the other's
reading = { sensor: tstr, measure }

measure = ( temperature: float64 // humidity: uint )

; A choice in a map, each alternative tagged by a literal
event = { type: "start", at: uint // type: "stop", at: uint, code: int }

; A choice in a record array
range = [ uint, uint // tstr ]
