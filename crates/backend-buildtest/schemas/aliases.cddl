; Reference schema: type aliases and constraints

; Simple alias
device-id = uint

; Size-constrained string
device-name = tstr .size 32

; Range-constrained integer
temperature = int .ge -40 .le 85

; Byte string alias
payload = bstr

; Type operators (RFC 8610 §3.8, RFC 9165)
level = uint .within (1..5)

digit = uint .and (0..9)

; An exclusive range (`...`) still includes its lower bound
percent = uint .within (1...101)

offset = int .within (-8...8)

answer = 40 .plus 2

greeting = "hello, " .cat "world"

; Checked by cddlc validate; generated code holds the integer
flags = uint .bits flag-names

flag-names = &( read: 0, write: 1 )
