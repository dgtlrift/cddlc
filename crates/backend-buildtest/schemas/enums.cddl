; Reference schema: enum (choice) types

; String enum
status = "ok" / "warn" / "error"

; Integer enum  
priority = 1 / 2 / 3

; Enumerations (RFC 8610 §3.9): the choice of a group's member values
color = &colors

colors = ( red: 1, green: 2, blue: 3 )

light = { state: &( on: "on", off: "off" ), shade: &colors }
