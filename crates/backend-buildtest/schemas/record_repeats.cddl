; Reference schema: a record with one repeated member (RFC 8610 §3.4). Its
; items go inline, where it stands; every other member is required, so the
; array's length says how many items it has.

; A repeated member in the middle (RFC 9171's bundle)
bundle = [primary: uint, * extension: block, payload: bstr]
block = [kind: uint, data: bstr]

; At least one, at the end
path = [name: tstr, + step: tstr]

; Bounded, in the middle
few = [id: uint, 1*3 tag: uint, note: tstr]
